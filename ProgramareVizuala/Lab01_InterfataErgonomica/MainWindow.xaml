<Window x:Class="Lab01_InterfataErgonomica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab01_InterfataErgonomica"
        mc:Ignorable="d"
        Title="Cerere de eliberare a adeverinței" 
        Width="700" Height="600" 
        MinWidth="600" MinHeight="520" 
        WindowStartupLocation="CenterScreen" 
        FontFamily="Segoe UI" 
        FontSize="14" 
        Background="#F3F4F6">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Titlul aplicației -->
        <TextBlock Grid.Row="0" 
                   Text="Cerere de eliberare a adeverinței" 
                   FontSize="24" 
                   FontWeight="SemiBold" 
                   Foreground="#111827"/>
        <!-- Formularul -->
        <Grid Grid.Row="2" 
              Background="White" 
              Margin="0" 
              >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <!-- Nume -->
            <TextBlock Grid.Row="0" 
                       Grid.Column="0" 
                       VerticalAlignment="Center" 
                       Text="Nume *"/>
            <TextBox x:Name="txtNume" 
                     Grid.Row="0" 
                     Grid.Column="1" 
                     Height="32" 
                     Margin="8" 
                     Padding="6" 
                     VerticalContentAlignment="Center" 
                     TabIndex="0"/>
            <!-- Prenume -->
            <TextBlock Grid.Row="1" 
                       Grid.Column="0" 
                       VerticalAlignment="Center" 
                       Text="Prenume *"/>
            <TextBox x:Name="txtPrenume" 
                     Grid.Row="1" 
                     Grid.Column="1" 
                     Height="32" 
                     Margin="8" 
                     Padding="6" 
                     VerticalContentAlignment="Center" 
                     TabIndex="1"/>
            <!-- Grupa -->
            <TextBlock Grid.Row="2" 
                       Grid.Column="0" 
                       VerticalAlignment="Center" 
                       Text="Grupa *"/>
            <TextBox x:Name="txtGrupa" 
                     Grid.Row="2" 
                     Grid.Column="1" 
                     Height="32" 
                     Margin="8" 
                     Padding="6" 
                     VerticalContentAlignment="Center" 
                     TabIndex="2"/>
            <!-- Scopul adeverinței -->
            <TextBlock Grid.Row="3" 
                       Grid.Column="0" 
                       Margin="0,12,0,0" 
                       VerticalAlignment="Top" 
                       Text="Scopul *"/>
            <TextBox x:Name="txtScop" 
                     Grid.Row="3" 
                     Grid.Column="1" 
                     Height="110" 
                     Margin="8" 
                     Padding="6" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     TabIndex="3"/>
            <!-- Cerere urgentă -->
            <CheckBox x:Name="chkUrgenta" 
                      Grid.Row="4" 
                      Grid.Column="1" 
                      Margin="8" 
                      VerticalAlignment="Center" 
                      Content="Cererea este urgentă" 
                      TabIndex="4"/>
        </Grid>
        <!-- Butoanele -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="btnGoleste" 
                    Width="110" Height="36" 
                    Margin="0,0,12,0" 
                    Background="#E5E7EB" 
                    Foreground="#111827" 
                    Content="_Golește" 
                    TabIndex="5" 
                    Click="btnGoleste_Click"/>
            <Button x:Name="btnTrimite" 
                    Width="110" Height="36" 
                    Background="#2563EB" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    Content="_Trimite" 
                    IsDefault="True" 
                    TabIndex="6" 
                    Click="btnTrimite_Click"/>
        </StackPanel>
        <!-- Zona pentru mesaje -->
        <TextBlock x:Name="txtMesaj" 
                   Grid.Row="6" 
                   Padding="12" 
                   Background="White" 
                   Foreground="#374151" 
                   Text="Completează câmpurile obligatorii." 
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
